def main():
    st.header("Gerador de Nome da Obra")
    
    # Inputs que provavelmente existem na sua aba de "Capa" ou "Parâmetros"
    col1, col2, col3 = st.columns(3)
    with col1:
        tipo_obra = st.selectbox("Tipo de Obra", ["Residencial", "Comercial", "Infraestrutura"])
    with col2:
        local = st.text_input("Localidade / Cidade")
    with col3:
        ano = st.number_input("Ano", min_value=2020, max_value=2050, value=2026)
        
    if st.button("Gerar Nome"):
        if local:
            nome_obra = f"{tipo_obra.upper()} - {local.upper()} - {ano}"
            st.success(f"Nome da Obra Gerado: **{nome_obra}**")
        else:
            st.warning("Preencha a localidade para gerar o nome.")

    st.divider()
    
    st.header("Cálculos de Levantamentos")
    
    # Tabela interativa para substituir abas de digitação
    st.subheader("Entrada de Dados")
    
    # Exemplo de dataframe vazio para o usuário preencher no Streamlit
    df_vazio = pd.DataFrame(
        columns=["Item", "Descrição", "Unidade", "Comprimento", "Largura", "Altura", "Quantidade"]
    )
    
    df_editado = st.data_editor(df_vazio, num_rows="dynamic", use_container_width=True)
    
    if st.button("Calcular Levantamentos"):
        if not df_editado.empty:
            # Substitua esta lógica pelas fórmulas da sua planilha
            df_editado['Volume/Área Total'] = pd.to_numeric(df_editado['Comprimento']).fillna(1) * \
                                              pd.to_numeric(df_editado['Largura']).fillna(1) * \
                                              pd.to_numeric(df_editado['Altura']).fillna(1) * \
                                              pd.to_numeric(df_editado['Quantidade']).fillna(0)
            
            st.write("### Resultados")
            st.dataframe(df_editado, use_container_width=True)
            
            # Opção para download dos resultados
            csv = df_editado.to_csv(index=False).encode('utf-8')
            st.download_button(
                label="Baixar Resultados (CSV)",
                data=csv,
                file_name='resultados_levantamento.csv',
                mime='text/csv',
            )
        else:
            st.info("Insira dados na tabela para calcular.")

if __name__ == "__main__":
    main()
